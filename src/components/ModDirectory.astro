---
// 커뮤니티 카탈로그(CC0)에서 만든 mod 디렉터리. 데이터는 /data/mods.json을 브라우저가 받아 그린다.
// 첫 화면(별 많은 순 48개)은 빌드 때 HTML로 미리 그려 둔다: 자바스크립트 없이도, 검색 엔진에도 목록이 보이게
import stats from '../data/stats.json'
import { UI, CATEGORIES, LEVELS, langKey, cardText, descFile } from '../lib/modStrings.js'
import { loadMods } from '../lib/loadMods.js'
import { cardHtml } from '../lib/modCard.js'

interface Props {
  lang: string
}
const { lang } = Astro.props

const key = langKey(lang) as keyof typeof UI
const ui = UI[key]
const cats = Object.entries(CATEGORIES).map(([id, names]) => ({ id, name: names[key], n: (stats.byCategory as Record<string, number>)[id] ?? 0 }))
const cdn = process.env.NETLIFY === 'true' // Netlify 빌드에서만 이미지 CDN을 쓴다
const config = { ui, t: cardText(lang), cdn, desc: descFile(lang) }
const date = stats.generated.slice(0, 10)
const first: any[] = loadMods(lang).slice(0, 48)
---

<div class="mod-dir not-content" data-config={JSON.stringify(config)}>
  <div class="mod-dir__controls">
    <input type="search" class="mod-dir__search" placeholder={ui.search} aria-label={ui.search} />
    <div class="mod-dir__selects">
      <select class="mod-dir__sort" aria-label="sort">
        <option value="stars">{ui.sortStars}</option>
        <option value="new">{ui.sortNew}</option>
        <option value="recent">{ui.sortRecent}</option>
        <option value="name">{ui.sortName}</option>
      </select>
      <select class="mod-dir__level" aria-label={ui.access}>
        <option value="">{ui.anyAccess}</option>
        {LEVELS[key].map((name, i) => <option value={String(i)}>{`≤ ${name}`}</option>)}
      </select>
    </div>
  </div>
  <div class="mod-dir__chips" role="group">
    <button type="button" class="mod-dir__chip is-on" data-cat="">{ui.all} · {stats.total}</button>
    {cats.map(c => <button type="button" class="mod-dir__chip" data-cat={c.id}>{c.name} · {c.n}</button>)}
  </div>
  <p class="mod-dir__count" aria-live="polite">{ui.count.replace('{n}', stats.total.toLocaleString('en-US'))}</p>
  <ul class="mod-dir__list mod-grid" set:html={first.map(m => cardHtml(m, config.t, cdn)).join('')} />
  <button type="button" class="mod-dir__more" hidden={stats.total <= 48}>{ui.more}</button>
  <p class="mod-dir__source">{ui.source.replace('{date}', date).replace('{v}', stats.claudeVersion)}</p>
</div>

<script>
  import { cardHtml } from '../lib/modCard.js'
  type Mod = { n: string; r: string; u: string; a: string; d: string; s: number; l: string | null; lv: number; rl: string[]; c: string; b: number; p: string; cr: string; img: string | null; dw: string; w?: number; en?: string }
  const PAGE = 48
  for (const root of document.querySelectorAll<HTMLElement>('.mod-dir')) {
    const config = JSON.parse(root.dataset.config ?? '{}')
    const $ = <T extends Element>(sel: string) => root.querySelector(sel) as T
    const search = $<HTMLInputElement>('.mod-dir__search')
    const sort = $<HTMLSelectElement>('.mod-dir__sort')
    const level = $<HTMLSelectElement>('.mod-dir__level')
    const list = $<HTMLUListElement>('.mod-dir__list')
    const count = $<HTMLParagraphElement>('.mod-dir__count')
    const more = $<HTMLButtonElement>('.mod-dir__more')
    let cat = ''
    let shown = PAGE
    let mods: Mod[] = []

    const card = (m: Mod) => cardHtml(m, config.t, config.cdn)

    const render = () => {
      const q = search.value.trim().toLowerCase()
      const max = level.value === '' ? 9 : Number(level.value)
      let rows = mods.filter(m => (cat === '' || m.c === cat) && m.lv <= max && (q === '' || `${m.n} ${m.a} ${m.r} ${m.d} ${m.en ?? ''}`.toLowerCase().includes(q)))
      if (sort.value === 'new') rows = [...rows].sort((a, b) => b.cr.localeCompare(a.cr) || b.s - a.s)
      else if (sort.value === 'recent') rows = [...rows].sort((a, b) => b.p.localeCompare(a.p))
      else if (sort.value === 'name') rows = [...rows].sort((a, b) => a.n.localeCompare(b.n))
      count.textContent = rows.length === 0 ? config.ui.none : config.ui.count.replace('{n}', rows.length.toLocaleString())
      list.innerHTML = rows.slice(0, shown).map(card).join('')
      more.hidden = rows.length <= shown
    }
    const reset = () => {
      shown = PAGE
      render()
    }
    search.addEventListener('input', reset)
    sort.addEventListener('change', reset)
    level.addEventListener('change', reset)
    more.addEventListener('click', () => {
      shown += PAGE
      render()
    })
    for (const chip of root.querySelectorAll<HTMLButtonElement>('.mod-dir__chip')) {
      chip.addEventListener('click', () => {
        cat = chip.dataset.cat ?? ''
        for (const c of root.querySelectorAll('.mod-dir__chip')) c.classList.toggle('is-on', c === chip)
        reset()
      })
    }
    // 홈에서 넘어온 조건 (?cat=usage, ?sort=new, ?level=2)
    const params = new URLSearchParams(location.search)
    if (params.get('sort') && [...sort.options].some(o => o.value === params.get('sort'))) sort.value = params.get('sort') as string
    if (params.get('level') && [...level.options].some(o => o.value === params.get('level'))) level.value = params.get('level') as string
    const wanted = params.get('cat')
    if (wanted) {
      for (const c of root.querySelectorAll<HTMLButtonElement>('.mod-dir__chip')) {
        if (c.dataset.cat === wanted) {
          cat = wanted
          for (const o of root.querySelectorAll('.mod-dir__chip')) o.classList.toggle('is-on', o === c)
        }
      }
    }
    Promise.all([
      fetch('/data/mods.json').then(r => r.json()),
      config.desc ? fetch(config.desc).then(r => r.json()).catch(() => []) : Promise.resolve([]),
    ]).then(([data, desc]: [Mod[], (string | null)[]]) => {
      mods = data.map((m, i) => ({ ...m, en: m.d, d: desc[i] ?? m.d }))
      render()
    })
  }
</script>

<style>
  /* not-content라 Starlight 본문 스타일이 빠진다: 링크 색과 간격을 직접 준다 */
  .mod-dir :global(a) {
    color: var(--sl-color-text-accent);
  }
  .mod-dir__count,
  .mod-dir__source {
    margin: 1rem 0 0.5rem;
  }
  .mod-dir {
    margin-top: 1.5rem;
  }
  .mod-dir__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mod-dir__search {
    flex: 1 1 18rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  .mod-dir__selects {
    display: flex;
    gap: 0.5rem;
  }
  .mod-dir__selects select {
    padding: 0.45rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  .mod-dir__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .mod-dir__chip {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }
  .mod-dir__chip.is-on {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .mod-dir__count {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .mod-dir__more {
    display: block;
    margin: 1rem auto;
    padding: 0.5rem 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-accent);
    background: transparent;
    color: var(--sl-color-accent-high);
    cursor: pointer;
  }
  .mod-dir__source {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
