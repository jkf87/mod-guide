---
import Default from '@astrojs/starlight/components/Footer.astro'
const lang = Astro.locals.starlightRoute.lang
const notice: Record<string, string> = {
  en: 'Unofficial community guide. Not affiliated with or endorsed by Anthropic. Claude and Claude Code are trademarks of Anthropic.',
  ko: '비공식 커뮤니티 가이드입니다. Anthropic과 제휴하거나 승인받지 않았습니다. Claude와 Claude Code는 Anthropic의 상표입니다.',
  ja: '非公式のコミュニティガイドです。Anthropic との提携や承認はありません。Claude および Claude Code は Anthropic の商標です。',
  'zh-CN': '非官方社区指南，与 Anthropic 无关联，也未获其认可。Claude 与 Claude Code 是 Anthropic 的商标。',
  fr: 'Guide communautaire non officiel, sans lien avec Anthropic ni approuvé par Anthropic. Claude et Claude Code sont des marques d’Anthropic.',
  de: 'Inoffizieller Community-Leitfaden, nicht mit Anthropic verbunden oder von Anthropic unterstützt. Claude und Claude Code sind Marken von Anthropic.',
}
// 펼침 메뉴가 없는 화면(모바일 첫 페이지)에서도 언어를 바꿀 수 있게, 같은 페이지의 6개 언어 링크를 둔다
const langs = [['en', 'English'], ['ko', '한국어'], ['ja', '日本語'], ['zh-cn', '简体中文'], ['fr', 'Français'], ['de', 'Deutsch']]
const rest = Astro.url.pathname.replace(/^\/[^/]+/, '')
const current = Astro.url.pathname.split('/')[1]
---

<Default />
<nav class="langs" aria-label="Languages">
  {langs.map(([code, name]) => code === current
    ? <span aria-current="page">{name}</span>
    : <a href={`/${code}${rest}`} hreflang={code}>{name}</a>)}
</nav>
<p class="unofficial">{notice[lang] ?? notice.en}</p>

<style>
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
  }
  .langs a {
    color: var(--sl-color-gray-2);
  }
  .langs [aria-current] {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .unofficial {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
