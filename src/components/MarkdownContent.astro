---
import Default from '@astrojs/starlight/components/MarkdownContent.astro'
import AdSlot from './AdSlot.astro'
// 광고는 글 끝에만 둔다 (본문 읽기를 끊지 않게). 안내성 페이지(개인정보 등)에는 넣지 않는다
const id = Astro.locals.starlightRoute.id
// 디렉터리는 목록 위주라 본문 광고를 넣지 않는다 (AdSense: 콘텐츠가 적은 화면에 광고 금지)
const noAds = /(^|\/)(privacy|about|mods\/directory)$/.test(id)
---

<Default><slot /></Default>
{!noAds && <AdSlot slot="article" />}
